# Copy this file to .env.local and fill in the values below.
#
# Auth = Firebase. Database + file storage = Supabase. These are two
# separate projects/dashboards you'll need to set up — see CLAUDE.md for
# the full walkthrough (Firebase providers to enable, Supabase migrations
# to run, etc.).

# --- Firebase (Authentication only) -----------------------------------------
# Firebase Console → Project settings → General → Your apps → SDK setup.
# Safe to expose to the browser — these identify the project, they aren't
# secrets. Enable Google + Email/Password under Authentication → Sign-in method.
#
# No service account / private key is needed anywhere in this app: ID
# tokens are verified server-side against Google's public keys instead
# (src/lib/server/firebaseAdmin.ts, using NEXT_PUBLIC_FIREBASE_PROJECT_ID
# below) — deliberately avoiding firebase-admin, which caused unresolved,
# unexplained crashes in Vercel's serverless bundling for this project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Supabase (Database + Storage) ------------------------------------------
# Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" / "publishable" key — safe to expose to the browser. Used only
# by the public salon page to read salons/active services/active offers
# (see supabase/migrations/0001_init.sql for the RLS policies that limit it
# to exactly that).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" / "secret" key — bypasses Row Level Security entirely.
# Server-only. Used by src/lib/server/supabaseAdmin.ts for every owner
# read/write, after requireUid()/requireSalonOwnership() have checked the
# caller's Firebase token. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Misc --------------------------------------------------------------------
# Used to build absolute salon URLs (for the QR code) and metadata.
# Local dev: http://localhost:3000  |  Production: https://your-domain.tld
NEXT_PUBLIC_SITE_URL=http://localhost:3000
